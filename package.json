  "publisher": "elvis-budingensis",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Daniel Hensel"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Elvis-Budingensis/snd-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Elvis-Budingensis/snd-vscode/issues"
  },
  "homepage": "https://github.com/Elvis-Budingensis/snd-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
